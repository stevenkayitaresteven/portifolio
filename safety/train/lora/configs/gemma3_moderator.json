{
  "base_model": "google/gemma-3-4b-it",
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
  "load_in_4bit": true,
  "epochs": 2.0,
  "learning_rate": 0.0002,
  "batch_size": 8,
  "grad_accum": 2,
  "max_seq_len": 1024
}
